# 本地量化模型优先于远程 Embedding 服务。复制为 .env 后按需启用。
EMBEDDING_LOCAL_ENABLED=false
EMBEDDING_LOCAL_MODEL_PATH=D:/AI_Models/bge-base-zh-v1.5-model

# 关闭本地模型时，可配置 OpenAI 兼容 Embedding 服务。
# 点击检查时会发送一条固定的短诊断文本。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 可选：SQLite 文件位置。相对路径以项目目录为基准。
DATABASE_FILE=.data/project-chronicle.sqlite
